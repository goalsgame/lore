[Unit]
Description=Obtain/renew lore-server's Let's Encrypt certificate (ACME HTTP-01)
After=network-online.target
Wants=network-online.target
Before=lore-bootstrap.service
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/lore-cert-renew.sh
Restart=on-failure
RestartSec=30s
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
