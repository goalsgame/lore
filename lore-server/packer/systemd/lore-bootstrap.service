[Unit]
Description=Fetch lore-server's per-environment config and secrets
# Soft ordering only, not a hard Requires=: if lore-acme.service fails after
# its own retry budget, lore-bootstrap.sh's own cert-secret resolution is
# already non-fatal, so lore.service still starts (falling back to its
# built-in ephemeral self-signed cert) rather than the VM never serving at
# all -- a temporarily-untrusted cert is a better failure mode than a fully
# down server. See scripts/lore-cert-renew.sh's own doc comment.
After=lore-acme.service
Before=lore.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/lore-bootstrap.sh

[Install]
WantedBy=multi-user.target
