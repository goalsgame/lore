[Unit]
Description=Lore Server
After=network.target lore-bootstrap.service
Requires=lore-bootstrap.service

[Service]
User=lore
Group=lore
Environment=RUST_LOG=info
Environment=LORE_CONFIG_PATH=/etc/lore/config
# LORE_ENV and any secret-derived LORE__ overrides are supplied by
# lore-bootstrap.service at boot, not baked into the image — one image
# powers every environment. See ../scripts/lore-bootstrap.sh.
EnvironmentFile=-/etc/lore/config/lore-env.env
EnvironmentFile=-/etc/lore/config/secrets.env
ExecStart=/usr/local/bin/loreserver
LimitNOFILE=1048576
Restart=always
RestartSec=2s

# Hardening. There is no local persistent store to protect a writable path
# for — durable state lives in GCS/Firestore via the lore-gcp plugin — so
# this can be strict: PrivateTmp gives the process its own /tmp for any
# scratch use, and nothing under /etc/lore needs to be writable at runtime
# (lore-bootstrap writes it before this unit starts, as root).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/lore

[Install]
WantedBy=multi-user.target
