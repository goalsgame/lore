[Unit]
Description=Lore Server
After=network.target lore-bootstrap.service lore-cache-storage.service
Requires=lore-bootstrap.service lore-cache-storage.service

[Service]
User=lore
Group=lore
Environment=RUST_LOG=info
Environment=LORE_CONFIG_PATH=/etc/lore/config
# LORE_ENV and any secret-derived LORE__ overrides are supplied by
# lore-bootstrap.service at boot, not baked into the image — one image
# powers every environment. See ../scripts/lore-bootstrap.sh.
EnvironmentFile=-/etc/lore/config/lore-env.env
EnvironmentFile=-/etc/lore/config/secrets.env
ExecStart=/usr/local/bin/loreserver
LimitNOFILE=1048576
Restart=always
RestartSec=2s

# Lets lore.service bind a privileged port (e.g. 443).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. Durable state lives in GCS/Firestore via the lore-gcp plugin,
# not on this VM, so this can be strict: PrivateTmp gives the process its
# own /tmp for any scratch use, nothing under /etc/lore needs to be writable
# at runtime (lore-bootstrap writes it before this unit starts, as root),
# and the one real writable path is /var/lib/lore/cache — only used, and
# only needs to exist, if immutable_store.mode is ever set to "composite"
# (see lore-cache-storage.service).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# Not `yes`: that makes even a *nonexistent* path under $HOME return EACCES
# rather than ENOENT, which crash-loops the GCP client's ADC file-probing
# step (Application Default Credentials checks $HOME/.config/gcloud/... before
# falling back to the metadata server, and treats a permission error there as
# fatal rather than "try the next credential source"). `lore` has no home
# directory at all (useradd --no-create-home), so read-only still means
# nothing under /home is ever actually readable -- it just fails the way ADC
# expects.
ProtectHome=read-only
ReadOnlyPaths=/etc/lore
ReadWritePaths=/var/lib/lore/cache

[Install]
WantedBy=multi-user.target
